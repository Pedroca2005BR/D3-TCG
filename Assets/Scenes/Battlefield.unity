  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29e1044577ea6e2489a1e49d10658c1d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialText
  textMesh: {fileID: 433080346}
  text: "Aqui ficam os espa\xE7os de carta!\nAs cartas est\xE3o em jogo quando s\xE3o
    jogadas em algum desses locais!\nOs jogadores s\xF3 podem jogar as cartas nos
    espa\xE7os do seu lado do campo de batalha.\nQuando nos espa\xE7os, as cartas
    lutam com a carta em frente ao seu espa\xE7o ou, se n\xE3o tiver nenhuma, batem
    direto no her\xF3i inimigo."
