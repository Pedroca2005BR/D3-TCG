  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Todas as cartas t\xEAm valores de ataque e vida, um elemento ou tipo,
    identificado pela cor de suas bordas, al\xE9m de uma habilidade especial, que
    pode ser vista ao repousar o mouse na carta por 1 segundo.\n\nVoc\xEA ainda t\xEAm
    espa\xE7os vazios no campo! Tente encher o seu lado do campo de batalha!"
  m_isRightToLeft: 0
