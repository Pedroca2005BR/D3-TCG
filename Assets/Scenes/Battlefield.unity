      m_Calls: []
  m_text: "Aqui ficam os espa\xE7os de carta!\nAs cartas est\xE3o em jogo quando
    s\xE3o jogadas em algum desses locais!\nOs jogadores s\xF3 podem jogar as cartas
    nos espa\xE7os do seu lado do campo de batalha.\nQuando nos espa\xE7os, as cartas
    lutam com a carta em frente ao seu espa\xE7o ou, se n\xE3o tiver nenhuma, batem
    direto no her\xF3i inimigo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f8154ee961f11c94b87d10f92da0303a, type: 2}
