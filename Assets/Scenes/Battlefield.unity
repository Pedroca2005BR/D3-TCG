  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nesses dois cantos, residem a vida de cada um dos her\xF3is e a quantidade
    de cartas em cada deck.\nCaso a vida de um dos her\xF3is acabe, ganha o jogador
    oposto!\nSe acabar as cartas no deck, ganha quem tiver mais vida!\nBem simples,
    n\xE3o?\n\nGeralmente os decks possuem 15 cartas, mas o deck de tutorial possui
    menos para uma partida mais r\xE1pida! \nNesse caso, vamos acelerar o processo!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f8154ee961f11c94b87d10f92da0303a, type: 2}
